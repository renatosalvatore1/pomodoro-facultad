{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/trenes/:estacion/:destino", "destination": "/api/trenes?estacion=:estacion&destino=:destino" },
    { "source": "/api/trenes/:estacion", "destination": "/api/trenes?estacion=:estacion" }
  ]
}
